#!/bin/bash
# ShedOS First-Boot Developer Setup Wizard
# Collects developer information and configures git

# Skip in live environment
if [[ -f /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux ]] || \
   [[ -d /run/archiso ]] || \
   [[ "$USER" == "shedos" && -f /etc/calamares/settings.conf ]]; then
    exit 0
fi

MARKER_FILE="$HOME/.config/shedos-setup-complete"

# Check if already completed
if [[ -f "$MARKER_FILE" ]]; then
    exit 0
fi

# Ensure config directory exists
mkdir -p "$HOME/.config"

# Get the user's full name from system
FULL_NAME=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)
if [[ -z "$FULL_NAME" ]]; then
    FULL_NAME="$USER"
fi

# Show welcome dialog and collect information
RESULT=$(yad --form \
    --title="Welcome to ShedOS" \
    --text="<b><big>Welcome to ShedOS!</big></b>\n\nLet's set up your development environment.\nThis information will be used to configure git.\n" \
    --text-align=center \
    --width=500 \
    --height=400 \
    --center \
    --window-icon=preferences-system \
    --image=preferences-desktop-personal \
    --field="Full Name:":TEXT "$FULL_NAME" \
    --field="Email Address:":TEXT "" \
    --field="GitHub Username (optional):":TEXT "" \
    --field=":LBL" "" \
    --field="<i>You can change these settings later with 'git config'</i>:LBL" "" \
    --button="Skip:1" \
    --button="Configure:0" \
    2>/dev/null)

EXIT_CODE=$?

# User clicked Skip or closed the dialog
if [[ $EXIT_CODE -ne 0 ]]; then
    # Mark as complete even if skipped
    touch "$MARKER_FILE"

    # Show skip message
    yad --info \
        --title="Setup Skipped" \
        --text="You can configure git later by running:\n\n<tt>git config --global user.name \"Your Name\"\ngit config --global user.email \"your@email.com\"</tt>" \
        --width=400 \
        --center \
        --button="OK:0" \
        2>/dev/null
    exit 0
fi

# Parse the result (fields separated by |)
IFS='|' read -r NAME EMAIL GITHUB _ <<< "$RESULT"

# Validate email
if [[ -z "$EMAIL" || ! "$EMAIL" =~ "@" ]]; then
    yad --error \
        --title="Invalid Email" \
        --text="Please enter a valid email address." \
        --width=300 \
        --center \
        2>/dev/null

    # Re-run the wizard
    exec "$0"
fi

# Configure git
echo "Configuring git..."

git config --global user.name "$NAME"
git config --global user.email "$EMAIL"
git config --global init.defaultBranch main
git config --global core.editor nvim
git config --global color.ui auto
git config --global pull.rebase false
git config --global push.default current
git config --global push.autoSetupRemote true

# Add useful aliases
git config --global alias.st status
git config --global alias.co checkout
git config --global alias.br branch
git config --global alias.ci commit
git config --global alias.lg "log --oneline --graph --decorate"
git config --global alias.last "log -1 HEAD"
git config --global alias.unstage "reset HEAD --"

# Configure GitHub if provided
if [[ -n "$GITHUB" ]]; then
    git config --global github.user "$GITHUB"
fi

# Mark setup as complete
touch "$MARKER_FILE"

# Show success message
yad --info \
    --title="Setup Complete" \
    --text="<b>Your development environment is ready!</b>\n\nGit has been configured with:\n\n<tt>Name:  $NAME\nEmail: $EMAIL</tt>\n\nHappy coding! 🚀" \
    --width=400 \
    --center \
    --button="Get Started:0" \
    2>/dev/null

exit 0
