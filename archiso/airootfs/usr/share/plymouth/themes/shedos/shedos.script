# ShedOS Plymouth Boot Theme Script

# Screen and window setup
Window.SetBackgroundTopColor(0.95, 0.95, 0.95);
Window.SetBackgroundBottomColor(0.95, 0.95, 0.95);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Load the actual ShedOS logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 80;
logo.sprite.SetPosition(logo.x, logo.y, 10);

# Create spinning dots progress indicator
progress.dots = [];
progress.angle = 0;
progress.radius = 40;
progress.center_x = screen_width / 2;
progress.center_y = screen_height / 2 + 120;

# Create 8 dots
for (i = 0; i < 8; i++) {
    progress.dots[i].sprite = Sprite();
    progress.dots[i].image = Image.Text("●", 0, 0.5, 1, 1, "Sans 16");
    progress.dots[i].sprite.SetImage(progress.dots[i].image);
}

# Animation function
fun refresh_callback() {
    progress.angle += 0.1;
    
    for (i = 0; i < 8; i++) {
        angle = progress.angle + (i * 3.14159 * 2 / 8);
        x = progress.center_x + Math.Cos(angle) * progress.radius - 8;
        y = progress.center_y + Math.Sin(angle) * progress.radius - 8;
        
        # Fade effect
        opacity = (Math.Cos(angle - progress.angle) + 1) / 2;
        progress.dots[i].sprite.SetPosition(x, y, 20);
        progress.dots[i].sprite.SetOpacity(opacity);
    }
}

Plymouth.SetRefreshRate(30);
Plymouth.SetRefreshFunction(refresh_callback);

# Message display
message_sprite = Sprite();
message_sprite.SetPosition(screen_width / 2 - 150, screen_height - 60, 100);

fun message_callback(text) {
    my_image = Image.Text(text, 0, 0.5, 1, 1, "Sans 12");
    message_sprite.SetImage(my_image);
}

Plymouth.SetMessageFunction(message_callback);

# Display callback
fun display_normal_callback() {
    logo.sprite.SetOpacity(1);
}

fun display_password_callback(prompt, bullets) {
    # Show password prompt if needed
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Quit handler
fun quit_callback() {
    logo.sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
