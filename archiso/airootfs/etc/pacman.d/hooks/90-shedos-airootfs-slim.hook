# remove from airootfs!
# Squashfs slim-down: drop pacman cache, non-en locales, translated
# man pages, package doc/example dirs, GNU info. Idempotent; runs at
# every transaction's PostTransaction during pacstrap.

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Trimming live-ISO airootfs (pacman cache, locales, man, doc, info)...
When = PostTransaction
Depends = sh
Depends = coreutils
Depends = findutils
Exec = /bin/sh -c "rm -f /var/cache/pacman/pkg/*.pkg.tar.zst* 2>/dev/null; find /usr/share/locale -mindepth 1 -maxdepth 1 -type d ! -name 'en' ! -name 'en_US' ! -name 'C' -exec rm -rf {} + 2>/dev/null; find /usr/share/man -mindepth 1 -maxdepth 1 -type d ! -name 'man*' -exec rm -rf {} + 2>/dev/null; rm -rf /usr/share/doc/*/html /usr/share/doc/*/examples /usr/share/doc/*/*-translations 2>/dev/null; rm -rf /usr/share/info/*.info* 2>/dev/null; true"
