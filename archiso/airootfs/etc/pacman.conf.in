# Live ISO pacman.conf — used at runtime by:
#   - the live shell (sudo pacman ... in the live env)
#   - Calamares' shedos_pacstrap step (writes packages into /target)
# See archiso/pacman.conf.in for the BUILD-time variant used by mkarchiso.
#
# @CHANNEL@ is rendered at ISO build time by build-iso.yml: stable tag
# (v<CalVer>, no -rcN) → "stable"; RC tag / branch push → "test".

[options]
HoldPkg     = pacman glibc
Architecture = x86_64
Color
CheckSpace
ParallelDownloads = 4
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional

XferCommand = /usr/bin/curl -L -C - -f --retry 10 --retry-delay 5 --retry-max-time 60 --connect-timeout 30 -o %o %u

[shedos]
SigLevel = Required DatabaseRequired
Server = https://repo.shedos.org/@CHANNEL@/$arch

[core]
Include = /etc/pacman.d/mirrorlist

[extra]
Include = /etc/pacman.d/mirrorlist

[multilib]
Include = /etc/pacman.d/mirrorlist
