# ShedOS Limine Bootloader Configuration
# This template is used by the installer

timeout: 5

# Theme configuration
# interface_branding: ShedOS

/ShedOS Linux
    protocol: linux
    kernel_path: boot():/vmlinuz-linux
    kernel_cmdline: root=UUID={{ROOT_UUID}} rootflags=subvol=@ rootfstype=btrfs rw quiet splash {{NVIDIA_OPTS}}
    module_path: boot():/initramfs-linux.img

/ShedOS Linux (Fallback)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux
    kernel_cmdline: root=UUID={{ROOT_UUID}} rootflags=subvol=@ rootfstype=btrfs rw
    module_path: boot():/initramfs-linux-fallback.img

# Template for LUKS encrypted root
# kernel_cmdline: cryptdevice=UUID={{LUKS_UUID}}:cryptroot root=/dev/mapper/cryptroot rootflags=subvol=@ rootfstype=btrfs rw quiet splash
