# shedOS Zsh Configuration
# Based on Oh My Zsh with Powerlevel10k theme

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
ZSH_THEME="powerlevel10k/powerlevel10k"

# Oh My Zsh plugins
# Standard plugins: $ZSH/plugins/
# Custom plugins: $ZSH_CUSTOM/plugins/
plugins=(
	git
	extract
	colored-man-pages
	web-search
	aliases
	colorize
	encode64
	genpass
	history
	asdf
	zsh-autosuggestions
	zsh-syntax-highlighting
	screen
	ssh-agent
	urltools
	docker
	docker-compose
	gnu-utils
	golang
	postgres
	redis-cli
	node
	npm
	nvm
	battery
	themes
	tmux
	rust
	kubectl
	helm
	terraform
	ansible
)

source $ZSH/oh-my-zsh.sh

# User configuration

# Preferred editor
export EDITOR='nvim'
export VISUAL='nvim'

# Language environment
export LANG=en_US.UTF-8

# Compilation flags
export ARCHFLAGS="-arch $(uname -m)"

# Path additions
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# Automatically source NVIDIA environment variables if running in nvidia-only mode
if command -v glxinfo &> /dev/null && glxinfo -B | grep "OpenGL renderer string" | grep -q "NVIDIA"; then
    if [ -f "$HOME/.config/.nvidia/env.sh" ]; then
        source "$HOME/.config/.nvidia/env.sh"
    fi
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source "$HOME/.p10k.zsh"

(( ! ${+functions[p10k]} )) || p10k finalize

# shedOS welcome message
if [[ -o interactive ]] && [[ -z "$TMUX" ]] && [[ $- == *i* ]]; then
    if command -v fastfetch &> /dev/null; then
        fastfetch
    fi
fi
