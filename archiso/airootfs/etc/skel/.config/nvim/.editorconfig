# EditorConfig for Neovim
# Used by ktlint and other tools
# https://editorconfig.org

root = true

# Global settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Kotlin-specific
[*.{kt,kts}]
indent_size = 4
continuation_indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# JavaScript/TypeScript
[*.{js,jsx,ts,tsx}]
indent_size = 4

# JSON/YAML
[*.{json,yaml,yml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Python
[*.py]
indent_size = 4

# Go (uses tabs)
[*.go]
indent_style = tab
indent_size = 4

# Web files
[*.{html,css,scss}]
indent_size = 2

# SQL files
[*.sql]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 4

# XML/Config files
[*.{xml,gradle}]
indent_size = 2
