[flake8]
# Flake8 configuration for Neovim
# Relaxed settings focused on actual errors, not style nitpicks

# Maximum line length
max-line-length = 120

# Indentation
indent-size = 4

# Ignore common annoyances
ignore =
    # E203: whitespace before ':' (conflicts with Black)
    E203,
    # W503: line break before binary operator (conflicts with Black)
    W503,
    # E501: line too long (we use max-line-length)
    E501,
    # E402: module level import not at top of file
    E402,
    # F401: imported but unused (handled by LSP)
    # F841: local variable assigned but never used (too strict)
    F841

# Exclude common directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .tox,
    .mypy_cache,
    .pytest_cache

# Maximum complexity (cyclomatic complexity)
max-complexity = 15

# Per-file ignores
per-file-ignores =
    __init__.py:F401
