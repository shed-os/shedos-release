# ShedOS Mako Notification Configuration
# Theme: Catppuccin Mocha

# ─────────────────────────────────────────────────────────────
# General Settings
# ─────────────────────────────────────────────────────────────

sort=-time
layer=overlay
anchor=top-right

# ─────────────────────────────────────────────────────────────
# Appearance
# ─────────────────────────────────────────────────────────────

font=JetBrainsMono Nerd Font 10
background-color=#1e1e2edd
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
border-radius=10
padding=15
margin=10
width=350
height=150
max-icon-size=48
icons=1
icon-path=/usr/share/icons/Papirus-Dark

# ─────────────────────────────────────────────────────────────
# Behavior
# ─────────────────────────────────────────────────────────────

default-timeout=5000
ignore-timeout=0
max-visible=5
group-by=app-name

# ─────────────────────────────────────────────────────────────
# Actions
# ─────────────────────────────────────────────────────────────

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

# ─────────────────────────────────────────────────────────────
# Urgency Styles
# ─────────────────────────────────────────────────────────────

[urgency=low]
border-color=#a6adc8
default-timeout=3000

[urgency=normal]
border-color=#89b4fa
default-timeout=5000

[urgency=critical]
border-color=#f38ba8
background-color=#1e1e2eff
text-color=#f38ba8
default-timeout=0
ignore-timeout=1

# ─────────────────────────────────────────────────────────────
# App-specific Rules
# ─────────────────────────────────────────────────────────────

[app-name=Spotify]
border-color=#a6e3a1

[app-name=discord]
border-color=#89b4fa

[app-name=firefox]
border-color=#fab387

[app-name=volume]
border-color=#94e2d5
default-timeout=1500

[app-name=brightness]
border-color=#f9e2af
default-timeout=1500

# ─────────────────────────────────────────────────────────────
# Mode: Do Not Disturb
# ─────────────────────────────────────────────────────────────

[mode=dnd]
invisible=1
