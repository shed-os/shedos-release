path packages/
except packages/npm-cache
rename scripts/resolve-meta-closure.sh:tools/resolve-meta-closure.sh
rename scripts/render-meta-depends.sh:tools/render-meta-depends.sh
path archiso/
except archiso/airootfs/etc/pam.d/hyprlock
rename branding/issue:archiso/airootfs/etc/issue
rename branding/motd:archiso/airootfs/etc/motd
rename scripts/generate-package-list.sh:tools/generate-package-list.sh
rename scripts/download-packages.sh:tools/download-packages.sh
rename scripts/verify-cache.sh:tools/verify-cache.sh
rename scripts/pacman-offline-download.sh:tools/pacman-offline-download.sh
rename scripts/build-aur-packages.sh:tools/build-aur-packages.sh
rename scripts/bake-claude-code.sh:tools/bake-claude-code.sh
rename scripts/verify-shedos-deps.sh:tools/verify-shedos-deps.sh
path scripts/boot-assert.sh
path scripts/bios-boot-assert.sh
path scripts/emergency-boot-assert.sh
path scripts/encrypt-boot-assert.sh
path scripts/encrypt-powercut-assert.sh
path scripts/live-iso-lock-assert.sh
path scripts/test-iso.sh
path scripts/build-base-image.sh
path scripts/lib/encrypt-harness.sh
